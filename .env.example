# ====================================================================
# MÓDULO 1: CONSOLA DE MONITOREO SAP ERP (SAP NWRFC SDK)
# ====================================================================
# Modo de Operación (true = Conexión Real RFC con SAP NetWeaver / false = Simulación local)
SAP_LIVE=true

# Credenciales del Servidor SAP (Usuario de Servicio o Comunicación)
SAP_USER=tu_usuario_sap
SAP_PASSWORD=tu_password_sap

# Conexión al Application Server de SAP
SAP_ASHOST=10.0.0.100
SAP_SYSNR=00
SAP_CLIENT=300

# Cadena de enrutamiento seguro (SAP Router Corporativo)
SAP_ROUTER=/H/sap.tuempresa.com

# Identificador de Entorno
ENVIRONMENT_NAME=PRODUCTIVO

# ====================================================================
# MÓDULO 2: NOTIFICACIÓN SAP PRODUCCIÓN PLANTA (SAP CPI)
# ====================================================================
CPI_URL_CONSULTA=https://tu-subcuenta.it-cpi.cfapps.us21.hana.ondemand.com/http/get_order_prod_qas
CPI_URL_NOTIF=https://tu-subcuenta.it-cpi.cfapps.us21.hana.ondemand.com/http/registro_notificacion_qas
CPI_USER=usuario_cpi@tuempresa.com
CPI_PASS=tu_password_cpi

# Puerto del Servidor Web Unificado (por defecto 3000 -> 10.0.0.146:3000)
PORT=3000
