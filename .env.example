# Modo de Operación (true = Conexión Real RFC con SAP NetWeaver / false = Simulación local)
SAP_LIVE=true

# Credenciales del Servidor SAP (Usuario de Servicio o Comunicación)
SAP_USER=tu_usuario_sap
SAP_PASSWORD=tu_password_sap

# Conexión al Application Server de SAP
SAP_ASHOST=10.0.0.100
SAP_SYSNR=00
SAP_CLIENT=300

# Cadena de enrutamiento seguro (SAP Router Corporativo)
SAP_ROUTER=/H/sap.tuempresa.com

# Identificador de Entorno
ENVIRONMENT_NAME=PRODUCTIVO

# Puerto del Servidor Web (por defecto 3000)
PORT=3000
